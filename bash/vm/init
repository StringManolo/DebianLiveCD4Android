#!/bin/busybox sh
# PID 1 of the VM initramfs: receive the rootfs into a tmpfs (RAM), then hand over to it.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

rescue() {
  echo "[dlc] $1"
  echo "--- /sys/bus/virtio/devices:"; ls -la /sys/bus/virtio/devices 2>&1
  echo "--- /sys/class/virtio-ports:"; ls -la /sys/class/virtio-ports 2>&1
  echo "--- /dev:"; ls /dev 2>&1 | head -60
  echo "--- dmesg (tail):"; dmesg 2>&1 | tail -40
  echo "[dlc] rescue shell (exit = power off)"
  setsid cttyhack /bin/sh
  echo o > /proc/sysrq-trigger
  sleep 5
}

for m in failover net_failover virtio_mmio virtio_console virtio_net; do
  if [ -e /lib/modules/$m.ko ]; then
    insmod /lib/modules/$m.ko || echo "[dlc] insmod $m failed (may be built in)"
  fi
done

# The port number depends on how many virtio devices were probed first (vport<N>p1), so find it by its name.
find_port() {
  for d in /sys/class/virtio-ports/*; do
    [ -r "$d/name" ] || continue
    if [ "$(cat "$d/name")" = "rootfs" ]; then
      echo "/dev/$(basename "$d")"
      return 0
    fi
  done
  return 1
}

PORT=""
i=0
while [ $i -lt 30 ]; do
  PORT="$(find_port)" && break
  PORT=""
  sleep 1
  i=$((i+1))
done
[ -n "$PORT" ] || rescue "rootfs channel not found"
echo "[dlc] rootfs channel: $PORT"

mount -t tmpfs -o size=90%,mode=755 tmpfs /newroot
echo "[dlc] receiving rootfs into RAM..."
tar -x -C /newroot -f "$PORT" || rescue "tar reported errors"
[ -x /newroot/bin/sh ] || [ -L /newroot/bin/sh ] || rescue "rootfs looks empty"

# user-mode (slirp) networking
ip link set lo up
if ip link show eth0 >/dev/null 2>&1; then
  ip link set eth0 up
  ip addr add 10.0.2.15/24 dev eth0
  ip route add default via 10.0.2.2
  echo "nameserver 10.0.2.3" > /newroot/etc/resolv.conf
fi

mkdir -p /newroot/proc /newroot/sys /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
mkdir -p /newroot/dev/pts /newroot/dev/shm
mount -t devpts devpts /newroot/dev/pts
mount -t tmpfs tmpfs /newroot/dev/shm

# keep a static busybox inside the new root (RAM only): its cttyhack gives the shell a real controlling terminal,
# which a plain "sh" started as PID 1 does not have (no job control, Ctrl-C does not work).
mkdir -p /newroot/.dlc
cp /bin/busybox /newroot/.dlc/busybox

echo "[dlc] rootfs ready, switching root. Tip: run 'stty rows N cols M' to match your screen."
exec switch_root /newroot /.dlc/busybox sh -c '
export HOME=/root TERM=xterm-256color LANG=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /root
if [ -x /bin/bash ]; then SH=/bin/bash; else SH=/bin/sh; fi
echo "[dlc] starting $SH (this is PID 1: leaving it powers the VM off)"
exec /.dlc/busybox cttyhack $SH -l
'
